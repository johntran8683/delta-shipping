# Copy to apps/api/.env and apps/web/.env.local as needed

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://delta:delta@localhost:5432/delta_shipping"

# API (generate a strong secret for production)
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_SEC="28800"

# Next.js → API (browser calls this URL)
NEXT_PUBLIC_API_URL="http://localhost:3001"
