# Production environment for `docker-compose.prod.yml`.
# Copy to `.env` on the server and fill in real values. Never commit `.env`.
#
# NOTE: POSTGRES_PASSWORD is embedded in DATABASE_URL, so use only URL-safe
# characters (letters, digits, and - _ . ~). Avoid @ : / ? # & = + in it.

# --- Database ---
POSTGRES_USER=delta
POSTGRES_PASSWORD=change-me-to-a-long-url-safe-password
POSTGRES_DB=delta_shipping

# --- API ---
# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_SEC=28800
# Where browsers reach the web app (comma-separated if more than one).
# With no domain yet, use the server's public IP, e.g. http://203.0.113.10:3000
CORS_ORIGIN=http://YOUR_SERVER_IP:3000

# --- Web ---
# Baked into the web bundle at build time. Must be reachable from browsers.
# With no domain yet, use the server's public IP, e.g. http://203.0.113.10:3001
WEB_API_URL=http://YOUR_SERVER_IP:3001

# --- First-deploy admin seeding ---
# Set RUN_SEED_ON_BOOT=1 for the very first start so the admin account is
# created, then set it back to 0 (or remove the SEED_* lines) afterwards.
RUN_SEED_ON_BOOT=1
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change-this-immediately-after-first-login
